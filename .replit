modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Advanced LivePortrait"

[[workflows.workflow]]
name = "Advanced LivePortrait"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd .conversation/advanced-liveportrait && .venv/bin/python -u app.py --server_name 0.0.0.0 --server_port 8000 --inbrowser false"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
